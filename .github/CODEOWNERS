# CODEOWNERS (TEKNIK-TASARIM §8.5, Constitution "main'e merge koşulları").
# Ruleset "require_code_owner_review" ile birlikte: aşağıdaki yollara dokunan her PR'da, bot PR'ları
# dahil, kod sahibinin (insan) onayı zorunludur. Sahipler gerçek ve repoya yazma yetkisi olan
# kullanıcı/takım olmalıdır; ekip netleşince bir org takımıyla değiştirin (ör. @ThinkGOtr/<takım>).
# Son eşleşen satır kazanır.

# Page object kütüphanesi ve locator'lar (onarım PR'ları buraya dokunur).
/demo-app/e2e/pages/        @gokhansipahi

# Kod üretiminin (CasesToCode) şablondan yazdığı testler: bot PR'ı → insan kod sahibi onayı.
/demo-app/e2e/tests/generated/  @gokhansipahi

# Kalite kapılarının dayandığı yapılandırma (Constitution IV: tsc --strict, eslint
# --no-inline-config; testDir/proje ayarları). PR bu dosyaları değiştirerek kapıyı gevşetemesin.
# tsconfig.json ayrıca ast-guard'da (pr modu) strict için denetlenir.
/demo-app/e2e/tsconfig.json          @gokhansipahi
/demo-app/e2e/eslint.config.js       @gokhansipahi
/demo-app/e2e/playwright.config.ts   @gokhansipahi
/demo-app/e2e/package.json           @gokhansipahi
/demo-app/e2e/package-lock.json      @gokhansipahi
/demo-app/ci/                        @gokhansipahi

# Java karşılıkları (009 uygulama hattı e2e-app, 011 web hattı e2e-java): page object'ler ve
# Kimlikler (onarım PR'ları), üretilen testler (bot PR'ı), kalite kapısı yapılandırması (pom kilidi:
# toolchain/e2e-java-deps/pom.xml ve toolchain/e2e-app-deps/pom.xml ile bayt eşit; TestNG takımı).
/demo-app/e2e-java/src/test/java/com/antreklabs/bayi/ekranlar/  @gokhansipahi
/demo-app/e2e-java/src/test/java/com/antreklabs/bayi/uretilen/  @gokhansipahi
/demo-app/e2e-java/pom.xml           @gokhansipahi
/demo-app/e2e-java/testng.xml        @gokhansipahi
/demo-app/e2e-java/.mvn/             @gokhansipahi
/demo-app/e2e-app/src/test/java/com/antreklabs/bayi/ekranlar/   @gokhansipahi
/demo-app/e2e-app/src/test/java/com/antreklabs/bayi/uretilen/   @gokhansipahi
/demo-app/e2e-app/pom.xml            @gokhansipahi
/demo-app/e2e-app/testng.xml         @gokhansipahi
/demo-app/e2e-app/.mvn/              @gokhansipahi

# CI, workflow'lar ve bu dosya.
/.github/                   @gokhansipahi

# CI'da zorunlu check olan AST koruması ve Sauce yapılandırması.
/toolchain/ast-guard/       @gokhansipahi
/toolchain/java-araclar/     @gokhansipahi
/toolchain/e2e-java-deps/    @gokhansipahi
/toolchain/e2e-app-deps/     @gokhansipahi
