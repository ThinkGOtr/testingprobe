# AI Testing Probe — yerel sırlar. `make env` bu dosyadan .env üretir ve boş parolaları rastgele doldurur.
# .env git dışıdır; gerçek değerleri asla commit etmeyin. Anahtarların sözleşmesi:
# specs/001-dev-foundation/contracts/env.md

# --- F0: zorunlu (make env otomatik üretir) ---
POSTGRES_PASSWORD=
TP_OWNER_PASSWORD=
TP_APP_PASSWORD=
DEMOAPP_OWNER_PASSWORD=
DEMOAPP_PASSWORD=
SEED_USER_PASSWORD=
DEMOAPP_RO_PASSWORD=
TP_SESSION_SECRET=
# jira-sim: PO girişi (po@sim.local) parolası ve /sim/* yönetim belirteci (X-Sim-Admin-Token)
JIRA_SIM_PO_PASSWORD=
JIRA_SIM_ADMIN_TOKEN=
# demo-app-api /test/reset + /test/break belirteci (X-Demoapp-Test-Token); yalnızca demo-app-api ve test-runner
DEMOAPP_TEST_TOKEN=

# --- Host portları (yalnızca 127.0.0.1'e açılır) ---
PG_PORT=55432
TP_API_PORT=8000
TP_PORTAL_PORT=8080
DEMO_WEB_PORT=8081
JIRA_SIM_PORT=8090

# --- Dış sistem seçimi (boş = yerel simülatör / REPLAY) ---
# auto: ANTHROPIC_API_KEY varsa live, yoksa replay · live · replay · record (live + replay kaydı yazar)
TP_MODEL_MODE=auto
# anthropic | azure_openai (iskelet)
TP_MODEL_PROVIDER=anthropic
# 1 = model girdisinde KVKK maskelemesi (TCKN, IBAN, telefon, e-posta)
TP_PII_MASKING=0
TP_DAILY_BUDGET_USD=30
TP_WORKFLOW_BUDGET_USD=2
# Gerçek Jira için: https://<site>.atlassian.net
JIRA_BASE_URL=
# Kullanıcıya gösterilen Jira bağlantılarının kökü; boş = jira-sim'in yerel adresi (gerçek Jira'da JIRA_BASE_URL)
JIRA_BROWSE_URL=
JIRA_PROJECT=TPD
# jira | xray
TP_TEST_MGMT=jira
# local | github
TP_FORGE=local
GITHUB_REPO=
# Merge kapısının zorunlu check adları (virgülle; boş = local-ci / GitHub ruleset listesi)
TP_REQUIRED_CHECKS=
# Jira kanalından PO onayı: izinli PO kimlikleri (e-posta/accountId, virgülle).
# JIRA_PO_ACCOUNT_IDS boş: jira-sim'de po@sim.local, gerçek Jira'da hiçbiri (onay kabul edilmez).
JIRA_PO_ACCOUNT_IDS=
# Ek PO izin listesi (boş = liste denetimi yok) ve ürünün bot accountId'leri (onay sayılmaz)
TP_PO_JIRA_USERS=
TP_JIRA_BOT_ACCOUNT_IDS=
# 1 = provadaki gibi: replay kaydı yoksa altın örneğe düşmek yerine hata (REPLAY-MISS yok)
TP_REPLAY_STRICT=0
# core-api: X-Forwarded-For'a yalnızca bu eşlerden (IP, CIDR veya ad) gelen bağlantıda güvenilir
TP_TRUSTED_PROXIES=review-portal
# core-api: durum değiştiren isteklerde izinli Origin listesi (CSRF). Boş = portalın 127.0.0.1 / localhost adresi
TP_ALLOWED_ORIGINS=

# --- Sonraki özellikler (F0'da boş kalabilir) ---
# F2a model geçidi
ANTHROPIC_API_KEY=
# F3 Jira / Rovo
JIRA_READ_EMAIL=
JIRA_READ_TOKEN=
JIRA_WRITE_EMAIL=
JIRA_WRITE_TOKEN=
# Hafta 2 Xray Cloud
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
# Xray Cloud API kökü (boş = jira-sim Xray alt kümesi)
XRAY_BASE_URL=
# Hafta 1 tutarlılık denetimi (test edilen uygulama reposu, contents:read)
GITHUB_READ_TOKEN=
# F1 PR açan GitHub App
GH_APP_ID=
GH_APP_PRIVATE_KEY_PATH=
GH_APP_PRIVATE_KEY=
GH_APP_INSTALLATION_ID=
# App yerine düz token (okuma/yazma) ve insan merge token'ı (bot asla merge etmez)
GITHUB_TOKEN=
GITHUB_MERGE_TOKEN=
GITHUB_API_URL=
# Azure OpenAI (iskelet; ileride)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Story başına manuel test tasarımı baz süresi (saniye). F0 ölçümünden doldurun; boş = "ölçülmedi"
# (portal kazanç oranı göstermez). REPLAY'de AI süresi ~0 olduğundan kazanç yalnızca review süresine dayanır.
TP_MANUAL_BASELINE_S=
