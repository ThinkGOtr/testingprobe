# AI Testing Probe — yerel sırlar. `make env` bu dosyadan .env üretir ve boş parolaları rastgele doldurur.
# .env git dışıdır; gerçek değerleri asla commit etmeyin. Anahtarların sözleşmesi:
# specs/001-dev-foundation/contracts/env.md

# --- F0: zorunlu (make env otomatik üretir) ---
POSTGRES_PASSWORD=
TP_OWNER_PASSWORD=
TP_APP_PASSWORD=
DEMOAPP_OWNER_PASSWORD=
DEMOAPP_PASSWORD=
SEED_USER_PASSWORD=
DEMOAPP_RO_PASSWORD=
TP_SESSION_SECRET=
# jira-sim: PO girişi (po@sim.local) parolası ve /sim/* yönetim belirteci (X-Sim-Admin-Token)
JIRA_SIM_PO_PASSWORD=
JIRA_SIM_ADMIN_TOKEN=
# demo-app-api /test/reset + /test/break belirteci (X-Demoapp-Test-Token); yalnızca demo-app-api ve test-runner
DEMOAPP_TEST_TOKEN=
# toolchain-worker uç noktaları belirteci (core-api/core-worker gönderir; test-runner'a verilmez)
TP_TOOLCHAIN_TOKEN=

# --- Host portları (yalnızca 127.0.0.1'e açılır) ---
PG_PORT=55432
TP_API_PORT=8000
TP_PORTAL_PORT=8080
DEMO_WEB_PORT=8081
JIRA_SIM_PORT=8090

# --- Yalıtılmış ikinci yığın (isteğe bağlı; ör. ayrı git worktree'de eval/deneme) ---
# Boş = compose projesi "testingprobe", imajlar testingprobe-*:local, volume'ler testingprobe_*.
# Doldurulursa compose, scripts/lib.sh (make reset/up/forge-init/demo-web-sync) ve imaj adları bu
# değerleri kullanır; ana yığının konteyner/volume/imajlarına dokunulmaz. Yukarıdaki portları da
# çakışmayacak değerlere çekin.
# COMPOSE_PROJECT_NAME=tp-deneme
# TP_IMAGE_PREFIX=tp-deneme

# --- Test verisi kataloğu sırları (specs/013 §3.3) ---
# Gizli katalog kayıtlarının değeri kataloğa yazılmaz; `TP_TESTVERI_` önekli ortam sırrından okunur.
# Demo parolası (docs/DEMO-VERISI.md; yerel demo, gerçek kimlik değil).
TP_TESTVERI_DEMO_PAROLA=Demo123!

# --- Dış sistem seçimi (boş = yerel simülatör / REPLAY) ---
# auto: ANTHROPIC_API_KEY varsa live, yoksa replay · live · replay · record (live + replay kaydı yazar)
TP_MODEL_MODE=auto
# anthropic | azure_openai (iskelet)
TP_MODEL_PROVIDER=anthropic
# 1 = model girdisinde KVKK maskelemesi (TCKN, IBAN, telefon, e-posta)
TP_PII_MASKING=0
TP_DAILY_BUDGET_USD=30
TP_WORKFLOW_BUDGET_USD=2
# Gerçek Jira için: https://<site>.atlassian.net
JIRA_BASE_URL=
# Kullanıcıya gösterilen Jira bağlantılarının kökü; boş = jira-sim'in yerel adresi. Gerçek Jira'da AÇIKÇA
# site adresini yazın (boş bırakılırsa bağlantılar yine jira-sim'e gider; docs/GERCEK-SISTEMLER.md §2)
JIRA_BROWSE_URL=
JIRA_PROJECT=TPD
# jira | xray
TP_TEST_MGMT=jira
# local | github
TP_FORGE=local
GITHUB_REPO=
# Merge kapısının zorunlu check adları (virgülle; boş = local-ci / GitHub ruleset listesi)
TP_REQUIRED_CHECKS=
# Jira kanalından PO onayı: izinli PO kimlikleri (e-posta/accountId, virgülle).
# JIRA_PO_ACCOUNT_IDS boş: jira-sim'de po@sim.local, gerçek Jira'da hiçbiri (onay kabul edilmez).
JIRA_PO_ACCOUNT_IDS=
# Ek PO izin listesi (boş = liste denetimi yok) ve ürünün bot accountId'leri (onay sayılmaz)
TP_PO_JIRA_USERS=
TP_JIRA_BOT_ACCOUNT_IDS=
# YALNIZ TEST: 1 = tek Jira hesabıyla uçtan uca deneme; ürünün okuma/yazma hesabının koyduğu
# tp-po-approved etiketi de PO onayı sayılır (bot dışlaması kapanır, `make status` uyarır).
# Varsayılan 0; sunumda MUTLAKA 0 olmalı.
TP_TEST_TEK_HESAP=0
# Jira yorumlarında rol @bahsetmeleri (accountId; boş = o rol bahsedilmez). Yalnızca bildirim: yetki
# vermez, onay sayılmaz. Ürünün her yorumu "🤖 AI Testing Probe:" ile başlar. PO soru yorumu → PO +
# Analist; yayın özeti → Testçi; Bug (yeni / mevcut kayda bağlama) → Mühendis + Testçi.
JIRA_HESAP_ANALIST=
JIRA_HESAP_PO=
JIRA_HESAP_MUHENDIS=
JIRA_HESAP_TESTCI=
# Portalda gösterilen kişi adları (yalnızca gösterim; yetki roldedir). Biçim: kullanici_adi=Ad Soyad,
# virgülle (ör. analist=Ayşe Yılmaz,sunucu=). Boş = demo varsayılanları (core/src/tp_core/seed.py).
TP_GORUNEN_ADLAR=
# 1 = provadaki gibi: replay kaydı yoksa altın örneğe düşmek yerine hata (REPLAY-MISS yok)
TP_REPLAY_STRICT=0
# core-api: X-Forwarded-For'a yalnızca bu eşlerden (IP, CIDR veya ad) gelen bağlantıda güvenilir
TP_TRUSTED_PROXIES=review-portal
# core-api: durum değiştiren isteklerde izinli Origin listesi (CSRF). Boş = portalın 127.0.0.1 / localhost adresi
TP_ALLOWED_ORIGINS=

# --- Sonraki özellikler (F0'da boş kalabilir) ---
# F2a model geçidi
ANTHROPIC_API_KEY=
# Çalışma alanına bağlı anahtar: API 400 + anthropic-workspace-id isterse doldurun (sır; loglanmaz, yalnızca core-worker)
ANTHROPIC_WORKSPACE_ID=
# --- Portal asistanı ve Öneri (specs/008-ai-asistan/contracts/env.md; hepsi isteğe bağlı) ---
# Asistanın model kipi: live | off (boş = off). Pipeline TP_MODEL_MODE'dan bağımsız; anahtar yukarıdaki
# ANTHROPIC_API_KEY (yalnızca core-worker'a geçer). Canlı asistan için sunucu .env'sine live yazılır.
TP_ASISTAN_MODEL_MODE=
# 0 = öneri uçları ve düğmesi kapalı (boş = 1; asistandan bağımsız geri alma)
TP_ASISTAN_ONERI=
# 0 = "Emin değil" cevapta otomatik Sonnet incelemesi kapalı (boş = 1; elle "Daha ayrıntılı" kalır)
TP_ASISTAN_OTOMATIK_DERIN=
# 1 = müşteri verisi kurulumu: TP_PII_MASKING=1 değilse asistan kapalı kalır (boş = 0)
TP_ASISTAN_MUSTERI_VERISI=
# Test edilen uygulamanın verisini (db_schema/db_query) sorabilen roller, virgülle (boş = tüm roller)
TP_ASISTAN_VERI_ROLLERI=
# Sohbet saklama süresi, gün (boş = 90; yumuşak silinenler dahil; ai_call/tool_call etkilenmez)
TP_ASISTAN_SAKLAMA_GUN=
# Saklama temizliği aralığı, saniye (boş = 21600; 0 = periyodik temizlik kapalı)
TP_ASISTAN_TEMIZLIK_S=
# 0 = worker'da asistan şeridi yok → asistan kapalı görünür (boş = 1)
TP_WORKER_ASISTAN_SERIT=
# Asistan şeridi iş parçacığı sayısı; global bekleyen soru sınırı bunun 2 katı (boş = 3)
TP_WORKER_ASISTAN_PARALEL=
# Öneri "Jira'yı aç" yeni kayıt adresi; https ve kökeni JIRA_BROWSE_URL ile aynı olmalı (boş = varsayılan)
JIRA_CREATE_URL=
# ci_log aracının GitHub iş logu için yalnız actions:read yetkili token (sır; boş = GITHUB_READ_TOKEN)
GITHUB_ACTIONS_READ_TOKEN=
# make eval-live sert bütçe tavanı (USD; yalnızca host'taki değerlendirme komutu)
TP_EVAL_BUDGET_USD=5
# F3 Jira / Rovo
JIRA_READ_EMAIL=
JIRA_READ_TOKEN=
JIRA_WRITE_EMAIL=
JIRA_WRITE_TOKEN=
# Hafta 2 Xray Cloud
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
# Xray Cloud API kökü (boş = jira-sim Xray alt kümesi)
XRAY_BASE_URL=
# Hafta 1 tutarlılık denetimi (test edilen uygulama reposu, contents:read)
GITHUB_READ_TOKEN=
# F1 PR açan GitHub App
GH_APP_ID=
GH_APP_PRIVATE_KEY_PATH=
GH_APP_PRIVATE_KEY=
GH_APP_INSTALLATION_ID=
# App yerine düz token (okuma/yazma) ve insan merge token'ı (bot asla merge etmez)
GITHUB_TOKEN=
# İnsan (demo-admin takımı üyesi) ince ayarlı token'ı: Contents + Pull requests yazma, yalnız demo
# deposu. Portal merge'ü ve GitHub kipinde demo kırılması/sıfırlaması PR'ları bu kimlikle yapılır.
GITHUB_MERGE_TOKEN=
GITHUB_API_URL=
# --- GitHub kipine özgü (TP_FORGE=github; local iken BOŞ bırakın: toolchain e2e kökünü ve 'main'i
# GitHub aynasından çözer). docs/GERCEK-SISTEMLER.md §5.5
# toolchain-worker'ın salt okunur GitHub aynası: https://github.com/<sahip>/<repo>.git
TP_FORGE_REMOTE_URL=
# Aynanın salt okuma token'ı (Contents: read); yalnızca toolchain-worker'a verilir
TP_FORGE_REMOTE_TOKEN=
# Forge deposunda e2e kökü (boş = e2e; GitHub demo deposu: demo-app/e2e)
TP_E2E_ROOT=
# Çalışan uygulama eşleşmesinin uygulama yolları (boş = web,api; GitHub: demo-app/web,demo-app/api)
TP_APP_PATHS=
# Java/Appium projesinin kökü (009; boş = e2e-app; GitHub demo deposu: demo-app/e2e-app)
TP_E2E_APP_ROOT=
# Azure OpenAI (iskelet; ileride)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Manuel test tasarımı baz süresi: story başına ÖLÇÜM portaldan (gereksinim detayı → "Manuel baz değer")
# ya da PUT /requirements/{id}/baseline ile girilir (giren + kaynak notu, geçmiş tutulur). Bu değişken
# yalnızca ölçümü olmayan story'ler için "varsayılan"dır (saniye; her yerde "varsayılan" etiketli,
# kazanca GİRMEZ). Değer uydurulmaz; boş = ölçülmeyen story'ler "ölçülmedi". REPLAY'de AI süresi
# ölçülmez: hazırlık süresi yalnız review süresidir. `make reset` sonrası kalan kopya portal değil,
# gözden geçirilmiş rules/baz-degerler.yaml dosyasıdır (yalnızca gerçek F0 ölçümü; sync'te uygulanır).
TP_MANUAL_BASELINE_S=
# Canlı çağrı hata/zaman aşımında aynı çağrıyı etiketli REPLAY'den sürdür (auto kipinde varsayılan açık;
# live'da kapalı; record/replay'de hiç). Etiket her zaman replay/replay_miss — asla "live".
# TP_REPLAY_FALLBACK=1
# Kasıtlı kırma koşusu (BREAK_CAMPAIGN) kırmızısı için bug taslağı (TEKNİK-TASARIM §2; testçi kararına
# bırakılır, Jira'ya yalnızca onayla yazılır). 0: taslak açılmaz (failure "jira_yazilmaz").
TP_TRIAGE_KIRMA_TASLAK=1

# --- AI Probe ortak girişi (specs/010-aiprobe-sso; varsayılan local = bugünkü yerel giriş) ---
# TP_AUTH_MODE=aiprobe
# AIPROBE_HOME_RUN_URL=https://aiprobe-home-<hash>-ew.a.run.app
# AIPROBE_ID_ORIGIN=https://home.aiprobe.antreklabs.com
# AIPROBE_ALLOWED_ORGS=antreklabs
# AIPROBE_HOME_SA=<aiprobe-home servis hesabı e-postası>
# AIPROBE_TP_AUDIENCE=https://testing.aiprobe.antreklabs.com

# --- Mobil / masaüstü (009) — docs/MOBIL-MASAUSTU.md, docs/CIHAZ-ALTYAPISI.md, docs/WINDOWS-VM.md ---
# Hepsi isteğe bağlıdır; açılmazsa compose varsayılanları geçerlidir (Android + iOS hosttaki Appium'da,
# Windows kapalı). Sır yoktur. Servisler varsayılan yığına girmez:
#   docker compose --profile mobil up -d app-mcp appium-gw
#   docker compose --profile mobil-windows up -d appium-gw-windows      # Windows VM (GCP ya da UTM)
#
# app-mcp (doğrulama ajanının aracı; compose `app-mcp`). Boş Appium adresi = o platform kapalı.
# APPIUM_URL_ANDROID=http://host.docker.internal:4723
# APPIUM_URL_IOS=http://host.docker.internal:4723
# APPIUM_URL_WINDOWS=http://192.168.64.2:4723
# Ajanın başlatabileceği TEK uygulama (app_launch uygulama seçemez):
# APP_ANDROID_PACKAGE=com.antreklabs.bayisiparis
# APP_ANDROID_ACTIVITY=.MainActivity
# APP_ANDROID_UDID=
# APP_IOS_BUNDLE_ID=com.antreklabs.bayisiparis
# APP_IOS_UDID=
# Windows: VM'deki .exe yolu ya da AUMID (zorunlu), argümanlar ve çalışma dizini (NovaWindows
# appArguments / appWorkingDir; tek tırnak ve denetim karakteri reddedilir):
# APP_WINDOWS_APP=C:\tp\bayi\win-arm64\BayiSiparis.exe
# APP_WINDOWS_ARGS=--api-url http://192.168.64.1:18081/api
# APP_WINDOWS_WORKDIR=C:\tp\bayi\win-arm64
# APP_MCP_IDLE_S=300
# core-worker → app-mcp. Yedek yol (konteyner UTM ağına ulaşamazsa app-mcp hostta süreç olarak):
# APP_MCP_URL=http://host.docker.internal:8932/mcp
#
# test-runner Java (Appium) koşusu (LocalForge `local-ci-<platform>`; runner/java_run.py). Appium'a
# yalnızca yönlendiriciler üzerinden: appium-gw (host:4723) ve appium-gw-windows (VM).
# TP_RUNNER_APPIUM_URL_ANDROID=http://appium-gw:4723
# TP_RUNNER_APPIUM_URL_IOS=http://appium-gw:4723
# TP_RUNNER_APPIUM_URL_WINDOWS=http://appium-gw-windows:4723
# appium-gw-windows'un TEK hedefi (host:port; açılışta biçimi doğrulanır):
# TP_WINDOWS_VM_APPIUM=192.168.64.2:4723
# Appium hostundaki uygulama (Windows: VM'deki yol) ve uygulama argümanları:
# TP_APP_ID_ANDROID=com.antreklabs.bayisiparis
# TP_APP_ID_IOS=com.antreklabs.bayisiparis
# TP_APP_ID_WINDOWS=
# TP_APP_PATH_WINDOWS=C:\tp\bayi\win-arm64\BayiSiparis.exe
# TP_APP_ARGS_WINDOWS=--api-url http://192.168.64.1:18081/api
# TP_APP_WORKDIR_WINDOWS=
# Forge deposunda e2e-app kökü: TP_E2E_APP_ROOT (GitHub kipi bölümünde)
#
# Yalnızca hostta koşan araçlar .env'i OKUMAZ (kabuk ortamından verin): `make cihaz-*`
# (TP_AVD, TP_SIM, TP_SIM_TIPI, TP_IOS_RUNTIME, TP_APPIUM_ADRES, TP_APPIUM_PORT, TP_APP_PAKETI),
# hostta app-mcp süreci (APP_MCP_HOST, APP_MCP_PORT, APP_MCP_ALLOWED_HOSTS, APP_MCP_WAIT_MAX_S,
# APP_MCP_SNAPSHOT_MAX_SATIR, APP_MCP_SNAPSHOT_MAX_KARAKTER, APP_MCP_OTURUM_ACMA_S, APP_ANDROID_APK,
# APP_IOS_APP, APP_IOS_DEVICE_NAME, APP_IOS_PLATFORM_VERSION) ve duman betikleri (APPIUM_URL,
# DUMAN_KANIT, DUMAN_MCP_URL, DUMAN_PORT, DUMAN_BAYI, DUMAN_PAROLA, TP_IOS_UDID). Ayrıntı:
# docs/CIHAZ-ALTYAPISI.md, toolchain/app-mcp/scripts/duman*.mjs.
#
# --- GCP Windows VM (tp-windows) — yalnızca tp-demo'daki .env'de açın; rehber: docs/WINDOWS-GCP.md ---
# Windows masaüstü testinin birincil yolu. VM'i Mac'ten açın (make windows-vm-olustur / -bekle), iç
# IP'sini (10.132.x.x; `deploy/gcp/windows-vm/vm.sh ip`) aşağıya yazın, `make up`. Sır yoktur.
# `mobil-windows` profili app-mcp + appium-gw-windows'u başlatır (`mobil` gerekmez: tp-demo'da hostta
# Appium yok). Var olan COMPOSE_PROFILES değerine virgülle ekleyin.
# COMPOSE_PROFILES=mobil-windows
# appium-gw-windows'un TEK hedefi: tp-windows iç IP'si + Appium portu (yalnızca tp-demo 10.156.0.2'den açık)
# TP_WINDOWS_VM_APPIUM=<tp-windows-ic-ip>:4723
# test-runner (Java koşusu, local-ci-windows) ve app-mcp (doğrulama ajanı) yönlendiriciden geçer:
# TP_RUNNER_APPIUM_URL_WINDOWS=http://appium-gw-windows:4723
# APPIUM_URL_WINDOWS=http://appium-gw-windows:4723
# VM'deki uygulama (kurulum.ps1 yerleştirir) ve API adresi (dış kapı → aynı demo-app-api; /test/*
# sıfırlaması test-runner'dan doğrudan demo-app-api'ye gider, veri tutarlı kalır):
# APP_WINDOWS_APP=C:\tp\uygulama\BayiSiparis.exe
# APP_WINDOWS_ARGS=--api-url https://bayi.testing-probe.antreklabs.com/api
# TP_APP_PATH_WINDOWS=C:\tp\uygulama\BayiSiparis.exe
# TP_APP_ARGS_WINDOWS=--api-url https://bayi.testing-probe.antreklabs.com/api
# GitHub kipinde masaustu-windows iş akışını zorunlu kılmak ayrı karardır (TP_PLATFORMS, .github/CI.md);
# bu VM yalnızca yerel `local-ci-windows` ve ajanı besler — TP_PLATFORMS'u bunun için değiştirmeyin.

# --- GCP (tek VM) yayını — yalnızca VM'deki .env'de açın; kurulum: docs/GCP-KURULUM.md ---
# COMPOSE_FILE=docker-compose.yml:deploy/gcp/docker-compose.gcp.yml
# TP_PORTAL_HOST=portal.<statik-ip>.sslip.io
# TP_DEMO_HOST=bayi.<statik-ip>.sslip.io
# TP_ACME_EMAIL=<let's encrypt bildirim e-postası>
# TP_ALLOWED_ORIGINS=https://portal.<statik-ip>.sslip.io
# TP_PUBLIC_BASE_URL=https://portal.<statik-ip>.sslip.io
# TP_MCP_PUBLIC_URL=https://portal.<statik-ip>.sslip.io/api/mcp
# TP_SESSION_COOKIE_SECURE=true
# TP_TRUSTED_PROXIES=review-portal,edge
