# AI Testing Probe — yerel sırlar. `make env` bu dosyadan .env üretir ve boş parolaları rastgele doldurur.
# .env git dışıdır; gerçek değerleri asla commit etmeyin. Anahtarların sözleşmesi:
# specs/001-dev-foundation/contracts/env.md

# --- F0: zorunlu (make env otomatik üretir) ---
POSTGRES_PASSWORD=
TP_OWNER_PASSWORD=
TP_APP_PASSWORD=
DEMOAPP_OWNER_PASSWORD=
DEMOAPP_PASSWORD=
SEED_USER_PASSWORD=
DEMOAPP_RO_PASSWORD=
TP_SESSION_SECRET=

# --- Host portları (yalnızca 127.0.0.1'e açılır) ---
PG_PORT=55432
TP_API_PORT=8000
TP_PORTAL_PORT=8080
DEMO_WEB_PORT=8081
MCP_PORT=8931
JIRA_SIM_PORT=8090

# --- Dış sistem seçimi (boş = yerel simülatör / REPLAY) ---
# auto: ANTHROPIC_API_KEY varsa live, yoksa replay
TP_MODEL_MODE=auto
# Gerçek Jira için: https://<site>.atlassian.net
JIRA_BASE_URL=
JIRA_PROJECT=TPD
# jira | xray
TP_TEST_MGMT=jira
# local | github
TP_FORGE=local
GITHUB_REPO=

# --- Sonraki özellikler (F0'da boş kalabilir) ---
# F2a model geçidi
ANTHROPIC_API_KEY=
# F3 Jira / Rovo
JIRA_READ_EMAIL=
JIRA_READ_TOKEN=
JIRA_WRITE_EMAIL=
JIRA_WRITE_TOKEN=
# Hafta 2 Xray Cloud
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
# Hafta 1 tutarlılık denetimi (test edilen uygulama reposu, contents:read)
GITHUB_READ_TOKEN=
# F1 PR açan GitHub App
GH_APP_ID=
GH_APP_PRIVATE_KEY_PATH=
