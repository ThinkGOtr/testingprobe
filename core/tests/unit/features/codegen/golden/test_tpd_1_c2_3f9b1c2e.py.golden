import pytest
from playwright.sync_api import Page

from pages.cart_page import CartPage
from pages.catalog_page import CatalogPage
from pages.login_page import LoginPage


@pytest.mark.uretilen
@pytest.mark.web
@pytest.mark.tp_case("3f9b1c2e-0000-5000-8000-0000000000c2")
@pytest.mark.story("TPD-1")
@pytest.mark.dealer("bayi1")
def test_tpd_1_c2_3f9b1c2e(page: Page) -> None:
    cart_page = CartPage(page)
    catalog_page = CatalogPage(page)
    login_page = LoginPage(page)

    # S1 — Giriş sayfasını aç
    login_page.goto()
    # S2 — Bayi kullanıcısıyla giriş yap
    login_page.login("bayi1", "Demo123!")
    # S3 — "Portakal Gazozu 1L" (P-001) kartında adedi 7 yapıp "Sepete ekle" butonuna bas
    catalog_page.add_to_cart("P-001", 7)
    # S4 — Üst menüden sepete git
    catalog_page.open_cart()
    # Beklenen sonuç (değerler onaylı case metninden)
    cart_page.expect_line_quantity("P-001", 7)
    cart_page.expect_free_quantity("P-001", 1)
    cart_page.expect_subtotal("175,00 TL")
    cart_page.expect_discount("25,00 TL")
    cart_page.expect_total("150,00 TL")
