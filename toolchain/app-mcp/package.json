{
  "name": "tp-app-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "app-mcp: doğrulama ajanının mobil/masaüstü aracı (Appium üstünde dar MCP yüzeyi; specs/009-mobil-masaustu §2.6).",
  "type": "module",
  "bin": {
    "app-mcp": "dist/src/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "npm run build && node --test --test-reporter=spec dist/test/*.test.js",
    "duman": "node scripts/duman.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "fast-xml-parser": "5.12.0",
    "webdriverio": "9.33.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
