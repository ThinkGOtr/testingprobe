#!/bin/sh
# Playwright MCP (Streamable HTTP on :8931). No vision caps (constitution V); the browser may only
# request MCP_ALLOWED_ORIGINS (required: an empty value would mean "allow all").
set -eu
: "${MCP_ALLOWED_ORIGINS:?MCP_ALLOWED_ORIGINS must be set}"
exec node /opt/toolchain/node_modules/@playwright/mcp/cli.js \
  --headless \
  --browser chromium \
  --host 0.0.0.0 \
  --port 8931 \
  --allowed-hosts '*' \
  --isolated \
  --caps=testing \
  --allowed-origins "$MCP_ALLOWED_ORIGINS" \
  --output-dir /tmp/playwright-mcp \
  "$@"
