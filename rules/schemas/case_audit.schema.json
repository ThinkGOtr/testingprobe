{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tp:case_audit",
  "title": "Case seti denetimi (P9, Agent Probe; specs/011 F5)",
  "x-version": 1,
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "KABUL",
        "DÜZELTME_GEREKLİ",
        "ENGELLE"
      ]
    },
    "decision_rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^AP-[0-9]{3}$"
          },
          "case_ref": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "control_no": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          },
          "issue": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "risk": {
            "type": "string",
            "enum": [
              "Yüksek",
              "Orta",
              "Düşük"
            ]
          },
          "suggested_fix": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "required": [
          "finding_id",
          "case_ref",
          "control_no",
          "issue",
          "rationale",
          "risk",
          "suggested_fix"
        ],
        "additionalProperties": false
      }
    },
    "missing_scenarios": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  },
  "required": [
    "decision",
    "decision_rationale",
    "findings",
    "missing_scenarios"
  ],
  "additionalProperties": false
}
