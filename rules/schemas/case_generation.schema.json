{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tp:case_generation",
  "title": "Test case üretimi (§7 test case şeması)",
  "x-version": 1,
  "type": "object",
  "properties": {
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "type": {
            "type": "string",
            "enum": [
              "positive",
              "negative",
              "boundary"
            ]
          },
          "risk": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "acceptance_criteria_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^AC[0-9]+$"
            },
            "minItems": 1
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^S[0-9]+$"
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "data": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "expected": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "action",
                "data",
                "expected"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 8
          },
          "expected_result": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "contains": {
              "const": "AI-generated"
            }
          }
        },
        "required": [
          "title",
          "type",
          "risk",
          "acceptance_criteria_refs",
          "preconditions",
          "steps",
          "expected_result",
          "tags"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 20
    }
  },
  "required": [
    "cases"
  ],
  "additionalProperties": false
}
