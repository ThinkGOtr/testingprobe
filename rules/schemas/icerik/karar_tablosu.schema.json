{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tp:icerik/karar_tablosu",
  "title": "Karar tablosu içeriği (012 §4.1) — karar_tablosu.icerik",
  "x-version": 1,
  "type": "object",
  "properties": {
    "ad": { "type": "string", "minLength": 1, "maxLength": 120 },
    "ac_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^AC[0-9]+$" },
      "maxItems": 20,
      "uniqueItems": true
    },
    "aciklama": { "type": "string", "maxLength": 1000 },
    "girdiler": {
      "type": "array",
      "items": { "$ref": "#/$defs/girdi" },
      "maxItems": 12
    },
    "ciktilar": {
      "type": "array",
      "items": { "$ref": "#/$defs/cikti" },
      "maxItems": 12
    },
    "satirlar": {
      "type": "array",
      "items": { "$ref": "#/$defs/satir" },
      "maxItems": 60
    }
  },
  "required": ["ad", "ac_refs", "girdiler", "ciktilar", "satirlar"],
  "additionalProperties": false,
  "$defs": {
    "ad": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
    "tur": { "type": "string", "enum": ["sayi", "metin", "mantiksal"] },
    "ifade": { "type": "string", "minLength": 1, "maxLength": 300 },
    "girdi": {
      "type": "object",
      "properties": {
        "ad": { "$ref": "#/$defs/ad" },
        "tur": { "$ref": "#/$defs/tur" },
        "birim": { "type": "string", "minLength": 1, "maxLength": 12 },
        "aciklama": { "type": "string", "maxLength": 300 }
      },
      "required": ["ad", "tur"],
      "additionalProperties": false
    },
    "cikti": {
      "type": "object",
      "properties": {
        "ad": { "$ref": "#/$defs/ad" },
        "tur": { "$ref": "#/$defs/tur" },
        "birim": { "type": "string", "minLength": 1, "maxLength": 12 },
        "aciklama": { "type": "string", "maxLength": 300 },
        "tolerans": { "type": "string", "pattern": "^[0-9]{1,12}(\\.[0-9]{1,12})?$" }
      },
      "required": ["ad", "tur"],
      "additionalProperties": false
    },
    "satir": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^R[0-9]{1,3}$" },
        "kosul": { "$ref": "#/$defs/ifade" },
        "cikti": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/ad" },
          "additionalProperties": { "$ref": "#/$defs/ifade" },
          "maxProperties": 12
        },
        "aciklama": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "kosul", "cikti"],
      "additionalProperties": false
    }
  }
}
