{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tp:bug_draft",
  "title": "Bug taslağı (§8.12)",
  "x-version": 1,
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "expected": {
      "type": "string",
      "minLength": 1
    },
    "actual": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "sauce_video",
              "allure",
              "trace",
              "screenshot",
              "log",
              "code",
              "data"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "ref"
        ],
        "additionalProperties": false
      }
    },
    "story_key": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "test_case_key": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+-[0-9]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "severity_suggestion": {
      "type": "string",
      "enum": [
        "critical",
        "major",
        "minor"
      ]
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "contains": {
        "const": "AI-generated"
      }
    }
  },
  "required": [
    "summary",
    "steps",
    "expected",
    "actual",
    "environment",
    "evidence",
    "story_key",
    "test_case_key",
    "severity_suggestion",
    "labels"
  ],
  "additionalProperties": false
}
