# Dış kapı (aiprobe-platform tp-vm): deploy/gcp/Caddyfile + JSON erişim logu.
# Log, VM'in boşta kapanma denetimi için zorunludur (aiprobe-platform infra/modules/vm-product/README.md):
# host'ta /mnt/tp-data/caddy-logs/access.log.
{
	email {$TP_ACME_EMAIL}
}

(dis_kapi) {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
		}
		format json
	}
}

{$TP_PORTAL_HOST} {
	import dis_kapi
	# SSE (/api/events) akışı tamponlanmadan geçer.
	reverse_proxy review-portal:8080 {
		flush_interval -1
	}
}

{$TP_DEMO_HOST} {
	import dis_kapi
	reverse_proxy demo-app-web:8080
}
