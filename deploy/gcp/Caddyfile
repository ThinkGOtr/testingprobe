# Dış kapı (GCP): otomatik HTTPS (Let's Encrypt). Kimlik doğrulama uygulamaların kendi girişlerindedir
# (portal kullanıcıları, bayi girişi); kapıda ayrıca basic auth yoktur.
{
	email {$TP_ACME_EMAIL}
}

(dis_kapi) {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

{$TP_PORTAL_HOST} {
	import dis_kapi
	# SSE (/api/events) akışı tamponlanmadan geçer.
	reverse_proxy review-portal:8080 {
		flush_interval -1
	}
}

{$TP_DEMO_HOST} {
	import dis_kapi
	reverse_proxy demo-app-web:8080
}
