<?xml version="1.0" encoding="utf-8"?>
<!-- Paket kaynağı yalnız nuget.org (makine/kullanıcı kaynakları devre dışı). Toolchain imajı restore'u
     çevrimdışı, imajda ısıtılmış önbellekten yapar; bu dosya güvenilir kopyayla bayt eşit olmalıdır. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
