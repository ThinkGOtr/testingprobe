<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Tarayıcı süiti: elle yazılmış referans testler (testler/) + şablondan üretilen testler (uretilen/).
  Gruplar: duman (temel akışlar), kampanya (kırarak doğrula), sifir-veri (sıfırlanmış veri ister),
  uretilen + web (Testing Probe üretimi).
  Birim testleri (birim/, grup "birim") tarayıcı istemez ve bu süite girmez: ./mvnw -q test -Dgroups=birim
  Paralellik: TypeScript e2e ile aynı, 2 işçi = 2 bayi (bayi1, bayi2). Sınıf başına bir iş parçacığı;
  eşzamanlı test sayısı bayi sayısını aşamaz (TestTabani işçi yuvası). @Bayi ile sabitlenen test o
  bayiyi süreçler arası kilitle alır.
-->
<suite name="Bayi Sipariş Portalı — web (Java)" parallel="classes" thread-count="2" verbose="1">
  <test name="web-e2e-java" preserve-order="true">
    <groups>
      <run>
        <exclude name="birim"/>
      </run>
    </groups>
    <packages>
      <package name="com.antreklabs.bayi.testler"/>
      <package name="com.antreklabs.bayi.uretilen"/>
    </packages>
  </test>
</suite>
