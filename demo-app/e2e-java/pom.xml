<?xml version="1.0" encoding="UTF-8"?>
<!--
  Bayi Sipariş Portalı — web arayüzü uçtan uca testleri (Java hattı).
  Java 17 + Playwright for Java + TestNG. TypeScript karşılığı: ../e2e (Playwright Test);
  uygulama (Appium) karşılığı: ../e2e-app. Page object'ler ../e2e/pages ile birebir aynı sözleşmedir.

  Koşum (bkz. README.md):
    ./mvnw -q test-compile                     derleme (tarayıcı gerekmez)
    ./mvnw -q test -Dgroups=birim              birim testleri (tarayıcı ve uygulama gerekmez)
    ./mvnw test                                tarayıcı koşusu (testng.xml: testler + uretilen, 2 iş parçacığı)
    ./mvnw test -Dgroups=kampanya              yalnız bir grup (testng.xml devre dışı kalır, tek iş parçacığı)

  Sistem özellikleri (ortam değişkeni karşılığı parantezde; ikisi de verilmezse varsayılan):
    base.url (BASE_URL)                 web kökü; varsayılan http://127.0.0.1:8081
    demo.api.url (DEMO_API_URL | API_URL)  /test/* uçları için API kökü; varsayılan <base.url>/api
    demoapp.test.token (DEMOAPP_TEST_TOKEN)  /test/* paylaşılan sırrı — ORTAMDAN verin, depoya yazmayın
    headless (HEADLESS)                 varsayılan true; pencereli koşu için false
  Tarayıcı PLAYWRIGHT_BROWSERS_PATH'ten (ya da Playwright'ın varsayılan önbelleğinden) açılır; test
  sırasında indirme yapılmaz. Tümü: src/test/java/com/antreklabs/bayi/altyapi/Ayarlar.java
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.antreklabs</groupId>
  <artifactId>bayi-e2e-java</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>Bayi Sipariş Portalı — web e2e (Playwright for Java + TestNG)</name>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Sürümler sabittir (aralık yok): çevrimdışı ve tekrarlanabilir derleme. -->
    <!--
      Playwright for Java: depo kökündeki .playwright-version (npm @playwright/test) ile AYNI
      tarayıcı derlemelerini kullanan sürüm. Java 1.64.0 sürücüsü Playwright çekirdeği 1.64.1'i
      paketler (Java'da 1.64.1 yayımlanmadı); eşitlik birim/SurumBirimTesti ile sabitlenir
      (driver/package/package.json sürümü = .playwright-version). .playwright-version yükselince
      aynı çekirdeği paketleyen Java sürümüne geçilir.
    -->
    <playwright.version>1.64.0</playwright.version>
    <testng.version>7.12.0</testng.version>
    <allure.version>2.35.5</allure.version>
    <extent.version>5.1.2</extent.version>
    <slf4j.version>2.0.20</slf4j.version>

    <!-- Varsayılan tarayıcı süiti; -Dgroups verilirse "gruplu" profili bunu devre dışı bırakır. -->
    <testng.suite>testng.xml</testng.suite>
    <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
    <!-- Extent (Spark) HTML raporu: <dizin>/index.html; birim koşusu ayrı dizine yazar (tarayıcı raporunu ezmez). -->
    <extent.rapor.dizini>${project.build.directory}/extent-report</extent.rapor.dizini>
    <!-- JUnit XML dizini; birim koşusu ayrı dizine yazar (ci/run-java-checks.sh), tarayıcı raporunu ezmez. -->
    <raporlar.dizini>${project.build.directory}/surefire-reports</raporlar.dizini>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
      <version>${playwright.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>${testng.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.qameta.allure</groupId>
      <artifactId>allure-testng</artifactId>
      <version>${allure.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Extent Reports 5 (Spark HTML); dinleyici: altyapi/ExtentRaporu (META-INF/services ile yüklenir). -->
      <groupId>com.aventstack</groupId>
      <artifactId>extentreports</artifactId>
      <version>${extent.version}</version>
      <scope>test</scope>
      <exclusions>
        <!-- Yalnızca Extent'in kendi derlemesinde gerekir; sınıf yolunda açıklama işlemcisi olmasın. -->
        <exclusion>
          <groupId>org.projectlombok</groupId>
          <artifactId>lombok</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.6</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.1.4</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>17</release>
          <compilerArgs>
            <arg>-Xlint:all,-processing</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <suiteXmlFiles>
            <suiteXmlFile>${testng.suite}</suiteXmlFile>
          </suiteXmlFiles>
          <!-- -Dgroups ile (testng.xml'siz) taranan sınıflar: adlar *Test / *Testi, iç sınıf yok. -->
          <includes>
            <include>**/testler/**/*.java</include>
            <include>**/uretilen/**/*.java</include>
            <include>**/birim/**/*.java</include>
          </includes>
          <!-- JUnit XML: target/surefire-reports/TEST-*.xml (ci/parse.py JUnit yolu). -->
          <reportsDirectory>${raporlar.dizini}</reportsDirectory>
          <trimStackTrace>false</trimStackTrace>
          <redirectTestOutputToFile>true</redirectTestOutputToFile>
          <systemPropertyVariables>
            <allure.results.directory>${allure.results.directory}</allure.results.directory>
            <extent.rapor.dizini>${extent.rapor.dizini}</extent.rapor.dizini>
            <kanit.dizini>${project.build.directory}/kanit</kanit.dizini>
            <playwright.surumu>${playwright.version}</playwright.surumu>
            <file.encoding>UTF-8</file.encoding>
          </systemPropertyVariables>
          <properties>
            <property>
              <!-- TestNG'nin kendi raporlayıcıları kapalı; JUnit XML'i Surefire yazar. -->
              <name>usedefaultlisteners</name>
              <value>false</value>
            </property>
          </properties>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      -Dgroups=<grup>[,<grup>] verilince testng.xml yerine Surefire'ın grup süzgeci kullanılır
      (Surefire, suiteXmlFiles varken groups'u yok sayar). Örn. birim testleri:
        ./mvnw -q test -Dgroups=birim
      Bu kipte koşu tek iş parçacığıdır (yalnız bayi1; "kırarak doğrula" kırmızı adımı böyle koşar).
      Tarayıcı grupları (duman, kampanya, uretilen) birim paketini içermez; birim testler "birim"
      dışındaki gruplarda yer almaz.
    -->
    <profile>
      <id>gruplu</id>
      <activation>
        <property>
          <name>groups</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <suiteXmlFiles combine.self="override"/>
              <groups>${groups}</groups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
