<?xml version="1.0" encoding="UTF-8"?>
<!--
  Bayi Sipariş Portalı — mobil (Android, iOS) ve Windows masaüstü uçtan uca testleri.
  Java 17 + Appium java-client + TestNG. Web karşılığı: ../e2e (Playwright).

  Koşum (bkz. README.md):
    ./mvnw -q test-compile                     derleme (cihaz gerekmez)
    ./mvnw -q test -Dgroups=birim              birim testleri (cihaz gerekmez)
    ./mvnw test -Dplatform=android             cihaz koşusu (testng.xml: testler + uretilen)
    ./mvnw test -Dplatform=ios -Dgroups=kampanya   yalnız bir grup (testng.xml devre dışı kalır)

  Sistem özellikleri (ortam değişkeni karşılığı parantezde; ikisi de verilmezse varsayılan):
    platform (PLATFORM)                 android | ios | windows
    appium.url (APPIUM_URL)             http://127.0.0.1:4723
    app.path (APP_PATH)                 .apk / .app / .exe yolu (verilmezse app.id kurulu uygulamayı açar)
    device.name (DEVICE_NAME)           emülatör / simülatör adı
    demo.api.url (DEMO_API_URL)         /test/* uçları için API kökü
    demoapp.test.token (DEMOAPP_TEST_TOKEN)  /test/* paylaşılan sırrı — ORTAMDAN verin, depoya yazmayın
  Tümü: src/test/java/com/antreklabs/bayi/altyapi/Ayarlar.java
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.antreklabs</groupId>
  <artifactId>bayi-e2e-app</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>Bayi Sipariş Portalı — uygulama e2e (Appium + TestNG)</name>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Sürümler sabittir (aralık yok): çevrimdışı ve tekrarlanabilir derleme. -->
    <appium.java-client.version>10.1.1</appium.java-client.version>
    <!-- java-client Selenium'u aralıkla ister ([4.42.0,5.0)); aralık çözümü ağ ister, burada sabitlenir. -->
    <selenium.version>4.52.0</selenium.version>
    <testng.version>7.12.0</testng.version>
    <allure.version>2.35.5</allure.version>
    <slf4j.version>2.0.20</slf4j.version>

    <!-- Varsayılan cihaz süiti; -Dgroups verilirse "gruplu" profili bunu devre dışı bırakır. -->
    <testng.suite>testng.xml</testng.suite>
    <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
    <!-- JUnit XML dizini; birim koşusu ayrı dizine yazar (ci/run-app-checks.sh), cihaz raporunu ezmez. -->
    <raporlar.dizini>${project.build.directory}/surefire-reports</raporlar.dizini>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.seleniumhq.selenium</groupId>
        <artifactId>selenium-bom</artifactId>
        <version>${selenium.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.appium</groupId>
      <artifactId>java-client</artifactId>
      <version>${appium.java-client.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-remote-driver</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-support</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>${testng.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.qameta.allure</groupId>
      <artifactId>allure-testng</artifactId>
      <version>${allure.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.6</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.1.4</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>17</release>
          <compilerArgs>
            <arg>-Xlint:all,-processing</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <suiteXmlFiles>
            <suiteXmlFile>${testng.suite}</suiteXmlFile>
          </suiteXmlFiles>
          <!-- -Dgroups ile (testng.xml'siz) taranan sınıflar: adlar *Testi / *Test, iç sınıf yok. -->
          <includes>
            <include>**/testler/**/*.java</include>
            <include>**/uretilen/**/*.java</include>
            <include>**/birim/**/*.java</include>
          </includes>
          <!-- JUnit XML: target/surefire-reports/TEST-*.xml (ci/parse.py JUnit yolu). -->
          <reportsDirectory>${raporlar.dizini}</reportsDirectory>
          <trimStackTrace>false</trimStackTrace>
          <redirectTestOutputToFile>true</redirectTestOutputToFile>
          <systemPropertyVariables>
            <allure.results.directory>${allure.results.directory}</allure.results.directory>
            <kanit.dizini>${project.build.directory}/kanit</kanit.dizini>
            <file.encoding>UTF-8</file.encoding>
          </systemPropertyVariables>
          <properties>
            <property>
              <!-- TestNG'nin kendi raporlayıcıları kapalı; JUnit XML'i Surefire yazar. -->
              <name>usedefaultlisteners</name>
              <value>false</value>
            </property>
          </properties>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      -Dgroups=<grup>[,<grup>] verilince testng.xml yerine Surefire'ın grup süzgeci kullanılır
      (Surefire, suiteXmlFiles varken groups'u yok sayar). Örn. birim testleri:
        ./mvnw -q test -Dgroups=birim
      Cihaz grupları (duman, kampanya, uretilen) birim paketini zaten içermez; birim testler
      "birim" dışındaki gruplarda yer almaz.
    -->
    <profile>
      <id>gruplu</id>
      <activation>
        <property>
          <name>groups</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <suiteXmlFiles combine.self="override"/>
              <groups>${groups}</groups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
